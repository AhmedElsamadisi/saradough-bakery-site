---
import { Image } from 'astro:assets';
import heroImage from '../assets/saradough-hero.png';
import '../styles/global.css';

const breads = [
  {
    name: 'Plain',
    price: '$10',
    description: 'Simple, classic, and perfectly sourdough. Crisp crust with a soft, chewy inside.',
  },
  {
    name: 'Cheddar & herbs',
    price: '$13',
    description: 'Sharp cheddar and fresh herbs folded into a tangy sourdough.',
  },
  {
    name: 'Crispy chilli oil crunch + cheddar',
    price: '$15',
    description: 'Spicy, savory, and seriously addictive—with sharp cheddar for the perfect kick.',
  },
  {
    name: 'French onion',
    price: '$18',
    description: 'Caramelized onions, gruyère, and mozzarella. Rich, savory, and irresistible.',
  },
];

const base = import.meta.env.BASE_URL;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Small-batch, naturally leavened sourdough from SaraDough Bakery in Bayonne, New Jersey." />
    <meta name="theme-color" content="#f7efe3" />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Allura&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&family=Montserrat:wght@400;500;600&display=swap" rel="stylesheet" />
    <title>SaraDough Bakery | Bayonne, NJ</title>
  </head>
  <body>
    <header class="site-header">
      <a class="wordmark" href={base} aria-label="SaraDough Bakery home">
        <span>Sara</span><em>Dough</em><small>Bakery</small>
      </a>
      <nav aria-label="Primary navigation">
        <a href="#menu">Menu</a>
        <a href="#bread-club">Bread club</a>
        <a href="#about">Our process</a>
      </nav>
      <a class="button button--small" href="https://www.instagram.com/saradough.bakery/" target="_blank" rel="noreferrer">Order on Instagram</a>
    </header>

    <main>
      <section class="hero" aria-labelledby="hero-title">
        <Image
          class="hero__image"
          src={heroImage}
          alt="Two naturally leavened sourdough loaves on linen, one sliced to show its airy crumb"
          widths={[720, 1080, 1536]}
          sizes="(max-width: 760px) 100vw, 58vw"
          loading="eager"
          fetchpriority="high"
        />
        <div class="hero__copy">
          <p class="eyebrow">Small-batch sourdough · Bayonne, NJ</p>
          <h1 id="hero-title">Made with love.<br /><em>Baked with time.</em></h1>
          <p class="hero__lede">Naturally leavened loaves with a crackly crust, tender crumb, and the kind of flavor only a long fermentation can make.</p>
          <div class="hero__actions">
            <a class="button" href="#menu">See today’s menu</a>
            <a class="text-link" href="#bread-club">Meet the bread club <span aria-hidden="true">→</span></a>
          </div>
        </div>
        <p class="hero__stamp" aria-label="Naturally leavened, long fermented, small batch">
          <span>Naturally leavened</span><span>Long fermented</span><span>Small batch</span>
        </p>
      </section>

      <section class="menu section" id="menu" aria-labelledby="menu-title">
        <div class="section-heading">
          <p class="eyebrow">The loaf list</p>
          <h2 id="menu-title">Sourdough, with personality.</h2>
          <p>Every loaf is mixed, folded, shaped, and baked in small batches.</p>
        </div>
        <div class="menu__list">
          {breads.map((bread) => (
            <article class="menu-item">
              <div class="menu-item__title">
                <h3>{bread.name}</h3>
                <span aria-hidden="true"></span>
                <p>{bread.price}</p>
              </div>
              <p>{bread.description}</p>
            </article>
          ))}
        </div>
        <div class="extras" aria-label="Bakery extras">
          <article>
            <p class="eyebrow">Brown butter</p>
            <h3>Chocolate chip cookies</h3>
            <p><strong>Half dozen $10</strong> · <strong>Dozen $18</strong></p>
          </article>
          <article>
            <p class="eyebrow">For home bakers</p>
            <h3>Live starter</h3>
            <p>2 oz · Active, healthy, and ready to bake. Ask about availability.</p>
          </article>
        </div>
      </section>

      <section class="club section" id="bread-club" aria-labelledby="club-title">
        <div class="club__intro">
          <p class="eyebrow">The SaraDough bread club</p>
          <h2 id="club-title">Your sourdough rhythm, handled.</h2>
          <p>Two fresh loaves arrive every two weeks—enough for the breakfast toast, the dinner table, and the slice that disappears before it cools.</p>
        </div>
        <div class="club__plans">
          <article class="club__card">
            <p class="club__label">The classics</p>
            <div class="club__price"><span>$49.99</span><small>/ month</small></div>
            <ul>
              <li><strong>2 regular loaves</strong> in every shipment</li>
              <li><strong>Delivered every two weeks</strong></li>
              <li><strong>4 regular loaves</strong> each month</li>
            </ul>
            <a class="button button--full" href="https://www.instagram.com/saradough.bakery/" target="_blank" rel="noreferrer">Choose the classics</a>
          </article>
          <article class="club__card club__card--specialty">
            <p class="club__label">Regular + specialty</p>
            <div class="club__price"><span>$79.99</span><small>/ month</small></div>
            <ul>
              <li><strong>1 regular + 1 specialty loaf</strong> in every shipment</li>
              <li><strong>Delivered every two weeks</strong></li>
              <li><strong>4 artisan loaves</strong> each month</li>
            </ul>
            <a class="button button--full" href="https://www.instagram.com/saradough.bakery/" target="_blank" rel="noreferrer">Choose regular + specialty</a>
          </article>
          <p class="club__note">Message <strong>“Bread Club”</strong> on Instagram to choose a plan and confirm shipping.</p>
        </div>
      </section>

      <section class="process section" id="about" aria-labelledby="process-title">
        <div class="section-heading section-heading--center">
          <p class="eyebrow">Slow bread is good bread</p>
          <h2 id="process-title">Flour, water, salt—and time.</h2>
        </div>
        <ol class="process__steps">
          <li><span>01</span><h3>Naturally leavened</h3><p>A living starter gives every loaf depth, character, and its signature tang.</p></li>
          <li><span>02</span><h3>Long fermented</h3><p>The dough rests until the flavor and texture are exactly where they should be.</p></li>
          <li><span>03</span><h3>Baked in small batches</h3><p>Each loaf gets hands-on attention, from the first fold to the final score.</p></li>
        </ol>
      </section>

      <section class="closing" aria-labelledby="closing-title">
        <p class="eyebrow">Fresh from Bayonne</p>
        <h2 id="closing-title">Good bread is worth waiting for.</h2>
        <a class="button" href="https://www.instagram.com/saradough.bakery/" target="_blank" rel="noreferrer">Follow @saradough.bakery</a>
      </section>
    </main>

    <footer>
      <a class="wordmark wordmark--footer" href={base} aria-label="SaraDough Bakery home">
        <span>Sara</span><em>Dough</em><small>Bakery</small>
      </a>
      <p>Made with love in Bayonne, New Jersey.</p>
      <p>© 2026 SaraDough Bakery</p>
    </footer>
  </body>
</html>
