{
  "name": "saradough-bakery-site",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "astro build",
    "test": "node --test scripts/site.test.mjs",
    "validate": "npm run check && npm run build && npm test",
    "deploy:cloudflare": "npm run validate && wrangler pages deploy dist --project-name saradough-bakery --branch main"
  },
  "dependencies": {
    "astro": "^7.3.4"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^5.9.2",
    "wrangler": "^4.136.3"
  }
}
